{
  "name": "hururaa",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -n fr,en -c blue,green \"npm:start-fr\" \"npm:start-en\"",
    "start-fr": "ng serve hururaa --configuration=development --port=4200",
    "start-en": "ng serve hururaa --configuration=development-en --port=4205",
    "build": "ng build hururaa --localize",
    "watch": "ng build hururaa --watch --configuration development",
    "test": "ng test hururaa",
    "test:ci": "ng test hururaa --watch=false --coverage",
    "extract-i18n": "ng extract-i18n --project=hururaa",
    "lint": "ng lint --project=hururaa",
    "gateway-api:generate": "npx openapi-generator-cli generate -i ../../backend/openapi/out/gateway.openapi.json -g typescript-angular --type-mappings AnyType=any --additional-properties=serviceSuffix=Api,npmName=@api/gateway,npmVersion=0.0.1,stringEnums=true,enumPropertyNaming=camelCase,supportsES6=true,withInterfaces=true --remove-operation-id-prefix -o projects/api/gateway",
    "gateway-api:build": "npm run ng -- build @api/gateway --configuration production",
    "hururaa-api-api:generate": "npx openapi-generator-cli generate -i ../../backend/openapi/out/hururaa-api.openapi.json -g typescript-angular --type-mappings AnyType=any --additional-properties=serviceSuffix=Api,npmName=@api/hururaa-api,npmVersion=0.0.1,stringEnums=true,enumPropertyNaming=camelCase,supportsES6=true,withInterfaces=true --remove-operation-id-prefix -o projects/api/hururaa-api",
    "hururaa-api-api:build": "npm run ng -- build @api/hururaa-api --configuration production",
    "api": "npm run gateway-api:generate && npm run gateway-api:build && npm run hururaa-api-api:generate && npm run hururaa-api-api:build"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/animations": "^21.2.24",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.24",
    "@angular/compiler": "^21.2.24",
    "@angular/core": "^21.2.24",
    "@angular/forms": "^21.2.24",
    "@angular/platform-browser": "^21.2.24",
    "@angular/router": "^21.2.24",
    "@messageformat/core": "^3.4.0",
    "@ngrx/signals": "^21.1.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@primeng/themes": "^21.0.4",
    "filesize": "^11.0.25",
    "google-libphonenumber": "^3.2.47",
    "language-name-map": "^0.3.0",
    "ng-circle-countdown": "^21.0.0",
    "ngx-device-detector": "^11.0.0",
    "ngx-image-compress": "^18.1.7",
    "ngx-image-cropper": "^9.1.7",
    "ngx-translate-messageformat-compiler": "^7.3.0",
    "p-intl-input-tel": "^21.1.0",
    "pf-ui": "https://bin.gov.pf/artifactory/api/npm/npm/pf-ui/-/pf-ui-21.0.14.tgz",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primelocale": "^2.5.0",
    "primeng": "^21.1.10",
    "remixicon": "^4.9.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.24",
    "@angular/localize": "^21.2.24",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "21.4.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "ng-packagr": "^21.2.7",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "^4.1.11"
  }
}
